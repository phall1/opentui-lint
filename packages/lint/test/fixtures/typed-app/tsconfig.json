{
  "compilerOptions": {
    "strict": true,
    // Spelled out as well as implied by `strict`: the type-aware tests
    // distinguish `string` from `string | undefined`, and that is the only
    // place a silently non-strict program would show.
    "strictNullChecks": true,
    // Named explicitly so a program built without them cannot resolve
    // `string[]`'s members to an error type and look merely "unprovable".
    "lib": ["ESNext"],
    "types": [],
    "jsx": "preserve",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  // The per-case files under src/cases are generated by the test before any
  // parse runs, so a glob rather than a pinned file list.
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
