{
  "name": "opentui-lint",
  "version": "0.3.0",
  "description": "An agent-first linter for OpenTUI terminal apps. Catches the crashes and silent no-ops TypeScript lets through.",
  "author": {
    "name": "Patrick Hall",
    "url": "https://github.com/phall1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phall1/opentui-lint.git",
    "directory": "packages/lint"
  },
  "homepage": "https://github.com/phall1/opentui-lint#readme",
  "bugs": {
    "url": "https://github.com/phall1/opentui-lint/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opentui-lint": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opentui",
    "lint",
    "eslint",
    "eslintplugin",
    "oxlint",
    "terminal",
    "tui",
    "design-system"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "catalog:sync": "bun scripts/sync-catalog.ts",
    "catalog:check": "bun scripts/sync-catalog.ts --check",
    "prepack": "bun scripts/prepack.ts",
    "postpack": "bun scripts/postpack.ts"
  },
  "peerDependencies": {
    "eslint": ">=9.30.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@types/bun": "latest",
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/parser": "^8.40.0",
    "effect": "4.0.0-rc.115",
    "eslint": "^9.33.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  }
}
