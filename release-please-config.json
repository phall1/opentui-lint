{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "opentui-lint",
      "changelog-path": "packages/lint/CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "packages/lint/package.json", "jsonpath": "$.version" }
      ],
      "exclude-paths": [
        "examples",
        "packages/conformance",
        "packages/conformance-solid",
        "packages/corpus",
        "packages/examples-conformance",
        "packages/oxlint-conformance"
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true }
      ]
    }
  }
}
