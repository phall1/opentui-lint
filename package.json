{
  "name": "opentui-lint-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter opentui-lint build",
    "test": "bun run --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "catalog:sync": "bun run --filter opentui-lint catalog:sync",
    "catalog:check": "bun run --filter opentui-lint catalog:check"
  },
  "devDependencies": {
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "bun@1.4.2",
  "version": "0.4.1"
}
